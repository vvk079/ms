# ─── RICHBAYY SERVER ENVIRONMENT ───────────────────────────────
# Copy this file to `.env` and fill in the real values.

# Server
NODE_ENV=development
PORT=5000

# Frontend origin (used for CORS + cookie settings)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/richbayy?retryWrites=true&w=majority

# JWT  (secret must be >= 32 chars; required in production)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRE=30d
# Cookie name for the auth token
COOKIE_NAME=richbayy_token

# Payments — leave unset/false until a real gateway is verified.
# When 'true', the server will accept ONLINE orders (wire up a gateway first).
PAYMENTS_ENABLED=false

# Transactional email (password reset). Leave blank in dev to log links to the
# console; set all three to send real emails via any SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RICHBAYY <no-reply@richbayy.com>

# ─── Firebase Phone Auth (PRIMARY customer sign-in) ────────────
# Firebase sends + verifies the SMS code in the browser; this server verifies the
# signed ID token it returns. Get these three from:
#   Firebase console → Project settings → Service accounts → Generate new private key
# Keep the private key quoted; \n escapes are converted automatically, so pasting
# the JSON value as-is works on Render/Vercel.
# Leave all three blank to fall back to the in-house OTP flow below.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── SMS / OTP (FALLBACK when Firebase is not configured) ──────
# Leave everything blank in dev: the OTP is printed to the server console and the
# flow stays fully testable at zero cost. In production pick ONE provider below.
#
# SMS_PROVIDER: console | fast2sms | twofactor | msg91 | twilio | textbelt
# Leave blank/auto to use whichever provider's keys are filled in.
SMS_PROVIDER=

# Fast2SMS (India, https://www.fast2sms.com) — free trial credits, OTP route.
FAST2SMS_API_KEY=

# 2Factor.in (India, https://2factor.in) — free trial OTPs; TEMPLATE = your
# DLT-approved template name (optional while on the trial sender).
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE=

# MSG91 (India, https://msg91.com) — free trial credits. Template must be
# DLT-approved and contain the ##OTP## variable.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Twilio (global, https://twilio.com) — $15 trial credit; trial can only text
# numbers you've verified in the console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Textbelt (https://textbelt.com) — key 'textbelt' sends 1 free SMS/day. Smoke
# tests only, not for production.
TEXTBELT_KEY=

# ImageKit (https://imagekit.io) — image storage/CDN
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# First admin (used by the seed script)
ADMIN_NAME=Richbayy Admin
ADMIN_EMAIL=admin@richbayy.com
ADMIN_PASSWORD=Admin@12345
